package {
    default_team: "trendy_team_enigma",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "service-vcn-sources",
    srcs: [
        "src/**/*.java",
        ":statslog-vcn-java-gen",
    ],
    visibility: [
        "//packages/modules/Connectivity/service-b",
    ],
}

java_library {
    name: "service-connectivity-b-pre-jarjar",
    defaults: ["framework-system-server-module-defaults"], // This is a system server jar

    sdk_version: "system_server_current",

    // TODO(b/210962470): Bump this to B
    min_sdk_version: "30",

    srcs: [
        ":service-vcn-sources",
    ],

    libs: [
        "android.net.ipsec.ike.stubs.module_lib",
        "framework-annotations-lib",
        "framework-connectivity-pre-jarjar",
        "framework-connectivity-t-pre-jarjar",
        "framework-connectivity-b-pre-jarjar",
        "framework-statsd.stubs.module_lib",
        "framework-wifi.stubs.module_lib",
        "keepanno-annotations",
        "modules-utils-statemachine",
        "service-connectivity-pre-jarjar",
        "unsupportedappusage",
    ],

    // TODO: b/374174952 Dynamically include these libs when VCN
    // modularization is released
    static_libs: [
        "net-utils-service-vcn",
        "modules-utils-handlerexecutor",
    ],

    apex_available: [
        "com.android.tethering",
    ],
}

genrule {
    name: "statslog-vcn-java-gen",
    tools: ["stats-log-api-gen"],
    cmd: "$(location stats-log-api-gen) --java $(out) --module vcn --javaPackage com.android.server.vcn.metrics --javaClass VcnStatsLog",
    out: ["com/android/server/vcn/metrics/VcnStatsLog.java"],
}

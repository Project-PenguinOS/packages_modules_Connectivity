package: "com.android.tethering.flags"
container: "com.android.tethering"

flag {
    name: "permission_map_uid_migration"
    namespace: "com_android_tethering"
    description: "The flag enables the bpf permission map migration from appid to uid."
    bug: "436242702"
}

flag {
  name: "net_capability_prioritize_unified_communications"
  namespace: "com_android_tethering"
  description: "Flag for NET_CAPABILITY_PRIORITIZE_UNIFIED_COMMUNICATIONS API"
  bug: "430509489"
}

flag {
    name: "show_entitlement_ui_to_requesters"
    namespace: "com_android_tethering"
    description: "Show entitlement UI to the requesters, instead of only admin users."
    bug: "376792293"
}

flag {
  name: "enable_incall_service_api"
  namespace: "com_android_tethering"
  description: "Flag for supporting IncallService API"
  bug: "430509489"
}

flag {
  name: "nsd_query_with_known_answer"
  namespace: "com_android_tethering"
  description: "The querier should include its known answers within each query packet"
  bug: "454491508"
}

flag {
    name: "encrypted_client_hello_dns"
    namespace: "com_android_tethering"
    description: "Enable new ECH-related DNS resolver changes"
    bug: "419020719"
}

flag {
    name: "nsd_use_network_callback_for_local_networks"
    namespace: "com_android_tethering"
    description: "Use NetworkCallback to monitor local network changes for NSD."
    bug: "452297472"
}

flag {
    name: "nsd_mdns_scan_offload"
    namespace: "com_android_tethering"
    description: "A flag to control whether offload callbacks should be sent for interfaces that do not otherwise support mDNS."
    bug: "395515556"
}

flag {
  name: "nsd_service_picker"
  namespace: "com_android_tethering"
  description: "Enable usage of a service picker for mDNS discovery"
  bug: "454248446"
}

flag {
  name: "collect_beta_metrics"
  namespace: "com_android_tethering"
  description: "Enable metrics collection from beta users"
  bug: "462217324"
}
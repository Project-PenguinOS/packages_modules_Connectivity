<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.multipacprocessor">

    <application
        android:label="@string/app_name"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true">

        <service android:name="com.android.multipacprocessor.MultiPacService"
                 android:permission="android.permission.MAINLINE_NETWORK_STACK"
                 android:exported="true">
            <!-- This intent is only used to find this service via PackageManager. -->
            <intent-filter>
                <action android:name="com.android.server.connectivity.intent.service.MULTI_PAC_SERVICE" />
            </intent-filter>
        </service>
    </application>
</manifest>

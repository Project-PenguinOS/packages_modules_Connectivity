package {
    default_team: "trendy_team_fwk_core_networking",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "MultiPacProcessor",
    certificate: "platform",
    sdk_version: "module_current",
    min_sdk_version: "31",
    updatable: true,
    apex_available: [
        "com.android.tethering",
    ],
    manifest: "AndroidManifest.xml",
    package_name: "com.android.multipacprocessor",
    static_libs: [
        "MultiPacProcessor-api",
        "MultiPacProcessor-impl",
    ],
}

android_library {
    name: "MultiPacProcessor-impl",
    min_sdk_version: "31",
    sdk_version: "module_current",
    srcs: ["src/com/android/multipacprocessor/MultiPacService.java"],
    visibility: ["//packages/modules/Connectivity:__subpackages__"],
    apex_available: ["com.android.tethering"],
    static_libs: ["MultiPacProcessor-api"],
}

// TODO: b/472280623 - rename this library to MultiPacProcessor-aidl.
android_library {
    name: "MultiPacProcessor-api",
    min_sdk_version: "31",
    sdk_version: "module_current",
    srcs: ["src/com/android/multipacprocessor/IMultiPacService.aidl"],
    visibility: ["//packages/modules/Connectivity:__subpackages__"],
    apex_available: ["com.android.tethering"],
}

package {
    default_team: "trendy_team_fwk_core_networking",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library {
    name: "libeventpolling",
    vendor_available: false,
    host_supported: false,
    header_libs: ["bpf_connectivity_headers"],
    srcs: ["LoopbackEventHandler.cpp"],
    shared_libs: [
        "libbase",
        "libcutils",
        "liblog",
    ],
    export_include_dirs: ["include"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wthread-safety",
    ],
    sanitize: {
        cfi: true,
    },
    apex_available: [
        "com.android.tethering",
    ],
    min_sdk_version: "30",
}

cc_test {
    name: "libeventpolling_test",
    test_suites: [
        "general-tests",
        "mts-tethering",
    ],
    test_config_template: ":net_native_test_config_template",
    header_libs: ["bpf_connectivity_headers"],
    srcs: [
        "LoopbackEventHandlerTest.cpp",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wthread-safety",
    ],
    version_script: ":connectivity_mainline_test_map",
    stl: "libc++_static",
    static_libs: [
        "libbase",
        "libeventpolling",
    ],
    shared_libs: [
        "liblog",
    ],
    compile_multilib: "both",
    multilib: {
        lib32: {
            suffix: "32",
        },
        lib64: {
            suffix: "64",
        },
    },
    min_sdk_version: "30",
}

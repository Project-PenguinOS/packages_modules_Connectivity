// APK to hold all the wifi overlayable resources.
package {
    default_team: "trendy_team_fwk_core_networking",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_defaults {
    name: "ServiceConnectivityResourcesDefaults",
    sdk_version: "module_current",
    min_sdk_version: "31",
    resource_dirs: [
        "res",
    ],
    srcs: [
        "src/**/*.java",
    ],
    libs: [
        "framework-annotations-lib",
        "framework-connectivity.stubs.module_lib",
        "framework-connectivity-t.stubs.module_lib",
    ],
    static_libs: [
        "androidx.appcompat_appcompat",
        "androidx.fragment_fragment",
        "service-connectivity-resources-aidl",
    ],
}

android_library {
    name: "ServiceConnectivityResourcesLib",
    defaults: ["ServiceConnectivityResourcesDefaults"],
    visibility: ["//packages/modules/Connectivity:__subpackages__"],
}

android_app {
    name: "ServiceConnectivityResources",
    defaults: ["ServiceConnectivityResourcesDefaults"],
    privileged: true,
    export_package_resources: true,
    updatable: true,
    certificate: ":com.android.connectivity.resources.certificate",
    apex_available: [
        "com.android.tethering",
    ],
}

java_library {
    name: "service-connectivity-resources-aidl",
    sdk_version: "module_current",
    min_sdk_version: "31",
    srcs: ["aidl/**/*.aidl"],
    aidl: {
        include_dirs: [
            "packages/modules/Connectivity/framework/aidl-export",
        ],
        local_include_dirs: ["aidl/"],
    },
    libs: [
        "framework-connectivity-t.stubs.module_lib",
    ],
    visibility: ["//packages/modules/Connectivity:__subpackages__"],
    apex_available: ["com.android.tethering"],
}

android_app_certificate {
    name: "com.android.connectivity.resources.certificate",
    certificate: "resources-certs/com.android.connectivity.resources",
}
